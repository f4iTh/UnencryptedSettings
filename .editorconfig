# https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

[*.cs]
indent_size = 2
brace_style = end_of_line

[*.{md,csproj,json,targets}]
indent_size = 2
insert_final_newline = false